{
  "name": "regenai",
  "private": true,
  "version": "0.0.0",
  "description": "Shopify-focused recovery commerce demo: live React/Three.js frontend, with Hydrogen, merchant application and Shopify Functions integration in progress.",
  "license": "MIT",
  "author": "Zahidul Islam <muhammadzahidulislam2222@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zahidulislam2222/regenai.git"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0",
    "npm": "^12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-storefront.mjs dev",
    "build": "node scripts/run-storefront.mjs build",
    "lint": "npm --workspaces --if-present run lint",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm --workspaces --if-present run test",
    "storefront": "node scripts/run-storefront.mjs",
    "ui": "npm --workspace packages/ui run",
    "postinstall": "node ./scripts/rebuild-native.mjs",
    "dev:frontend": "npm --workspace packages/storefront run dev:frontend",
    "build:frontend": "npm --workspace packages/storefront run build:frontend",
    "typecheck:frontend": "npm --workspace packages/storefront run typecheck:frontend"
  },
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "0.33.0",
    "@rollup/rollup-linux-x64-gnu": "4.60.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@unrs/resolver-binding-linux-x64-gnu": "1.11.1",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "volta": {
    "node": "24.20.0",
    "npm": "12.0.2"
  }
}
