# Copy to an ignored .env in this directory, then fill release values.
# Do not commit the private release environment.
COMPOSE_PROJECT_NAME=regenai-frontend
FRONTEND_NGINX_IMAGE=
FRONTEND_HOSTNAME=frontend.example.invalid
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_PORT=
FRONTEND_DIST_PATH=../../packages/storefront/dist/frontend
FRONTEND_MEMORY_LIMIT=128M
FRONTEND_CPU_LIMIT=0.50
FRONTEND_PIDS_LIMIT=32
FRONTEND_TMPFS_SIZE=16m
