# Copy only into a private local environment file. Never use production credentials here.
# Hydrogen CLI dev mode sets NODE_ENV=development. The built Node runtime requires
# an explicit production mode; use NODE_ENV=production when launching it locally.
NODE_ENV=development
LOCAL_DEVELOPMENT=true
PUBLIC_CANONICAL_ORIGIN=http://127.0.0.1:3001

# Shopify Storefront API settings
PUBLIC_STORE_DOMAIN=replace-with-store.myshopify.com
PUBLIC_CHECKOUT_DOMAIN=replace-with-store.myshopify.com
# Only needed when PUBLIC_CHECKOUT_DOMAIN is a custom domain; comma-separated exact host allowlist.
SHOPIFY_CHECKOUT_DOMAIN_ALLOWLIST=
PUBLIC_STOREFRONT_API_TOKEN=replace-with-test-storefront-token
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=replace-with-test-storefront-id
STOREFRONT_API_VERSION=2026-04
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
SHOP_ID=

# Required session secret: generate a random value with at least 32 characters.
# This empty placeholder fails closed until you configure a local secret.
SESSION_SECRET=
SESSION_COOKIE_NAME=regenai_session
SESSION_COOKIE_MAX_AGE_SECONDS=2592000
HYDROGEN_CACHE_NAMESPACE=regenai-hydrogen
HYDROGEN_CACHE_MAX_ENTRIES=512
HYDROGEN_CACHE_MAX_BYTES=33554432
HYDROGEN_CACHE_MAX_ENTRY_BYTES=262144
HYDROGEN_CACHE_MAX_TTL_MS=86400000
HYDROGEN_CACHE_MAX_KEY_BYTES=131072
HYDROGEN_CACHE_MAX_HEADER_BYTES=16384
HYDROGEN_CACHE_MAX_PENDING_WRITES=16
HYDROGEN_CACHE_READ_TIMEOUT_MS=5000

# Node runtime settings. The default bind is loopback; use 0.0.0.0 only in an isolated container.
NODE_SERVER_HOST=127.0.0.1
NODE_SERVER_PORT=3001
NODE_MAX_HEADER_SIZE_BYTES=16384
NODE_MAX_REQUEST_BODY_BYTES=1048576
NODE_HEADERS_TIMEOUT_MS=10000
NODE_REQUEST_TIMEOUT_MS=30000
NODE_HANDLER_TIMEOUT_MS=30000
NODE_SHUTDOWN_TIMEOUT_MS=10000
NODE_MAX_CONCURRENT_REQUESTS=128
NODE_MAX_STATIC_FILE_BYTES=20971520

# Storefront behavior defaults
HEADER_MENU_HANDLE=main-menu
FOOTER_MENU_HANDLE=footer
CUSTOMER_ACCOUNT_ENABLED=false
CUSTOMER_ACCOUNT_API_VERSION=2026-04
ANALYTICS_ENABLED=false
SENTRY_ENABLED=false
# Only required when SENTRY_ENABLED=true.
SENTRY_STOREFRONT_DSN=
