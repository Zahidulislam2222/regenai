# The app reads public settings from wrangler.toml in Workers environments.
# Keep any local development overrides gitignored and use unmistakably fake values.
SHOPIFY_APP_URL=https://app.example.test
SHOPIFY_API_SCOPES=read_products
SHOPIFY_API_KEY=test-key
SHOPIFY_API_SECRET=test-secret
SHOPIFY_TOKEN_ENC_KEY=base64-encoded-32-byte-test-key
SHOPIFY_OAUTH_STATE_TTL_SECONDS=600
SHOPIFY_SESSION_TTL_SECONDS=3600
REVIEW_QUEUE_LIMIT=50
SHOPIFY_WEBHOOK_MAX_BODY_BYTES=65536
PRIVACY_REQUEST_DEADLINE_DAYS=30
SENTRY_APP_DSN=Not yet configured
REGENAI_APP_BUILD_DIRECTORY=build
