{
  "name": "@regenai/app",
  "private": true,
  "version": "0.1.0",
  "description": "RegenAI merchant app scaffold — React Router on Cloudflare Workers + D1, with product-claim review queue and Rust Shopify Functions.",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "vite dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint app workers react-router.config.ts vite.config.ts",
    "test": "node --test",
    "deploy": "npm run build && wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@react-router/cloudflare": "7.18.4",
    "@shopify/polaris": "^13.9.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^4.20250927.0",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.18.4",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "isbot": "^5.1.32",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
